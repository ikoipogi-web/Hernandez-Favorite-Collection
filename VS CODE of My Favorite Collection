*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, sans-serif;
}

body{
background:#eef2f7;
}

header{
background:#1f4e79;
color:white;
text-align:center;
padding:20px;
}

.container{
width:90%;
margin:30px auto;
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 4px 10px rgba(0,0,0,.15);
}

h2{
margin-bottom:20px;
color:#1f4e79;
}

.gallery{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
}

.card{
width:200px;
text-align:center;
}

.card img{
width:100%;
height:220px;
object-fit:cover;
border-radius:10px;
border:3px solid #1f4e79;
transition:.3s;
}

.card img:hover{
transform:scale(1.05);
}

.music{
display:flex;
flex-direction:column;
align-items:center;
gap:25px;
}

.music iframe{
width:350px;
height:200px;
border:none;
border-radius:10px;
}

.videos{
font-size:18px;
line-height:2;
margin-left:25px;
}

footer{
margin-top:30px;
padding:15px;
text-align:center;
background:#1f4e79;
color:white;
}
